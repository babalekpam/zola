# ---------- Supabase (required) -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- LLM providers (set any you want enabled) ---------------------
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# ---------- Cloudflare Turnstile (optional — anti-bot on auth forms) ----
# Get keys: https://dash.cloudflare.com → Turnstile → Add Site
# Also enable Turnstile in Supabase Dashboard → Auth → Settings → Bot & Abuse
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------- Sentry (optional — error monitoring) ------------------------
# Get DSN: https://sentry.io → Project → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
