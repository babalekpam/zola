# See LAUNCH_CHECKLIST.md for a full production checklist.

# ---------- Supabase (required) ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- LLM providers (set any you want enabled) ---------------------
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# ---------- Production URL (used by sitemap, robots, OAuth) --------------
NEXT_PUBLIC_SITE_URL=

# ---------- Cloudflare Turnstile (optional — anti-bot on auth forms) ----
# https://dash.cloudflare.com → Turnstile
# Also enable in Supabase Dashboard → Auth → Bot & Abuse
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------- Sentry (optional — error monitoring) ------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---------- Stripe billing (optional — required for paid plans) ---------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
